{
  "name": "ai-infra-tutor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bg": "pm2 start npm --name \"ai-tutor\" -- run dev && pm2 save",
    "dev:bg:stop": "pm2 stop ai-tutor",
    "dev:bg:restart": "pm2 restart ai-tutor",
    "dev:bg:logs": "pm2 logs ai-tutor --lines 20",
    "dev:bg:status": "pm2 status ai-tutor",
    "dev:test": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/fix-lightningcss.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/oxide-darwin-x64": "^4.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lightningcss-darwin-x64": "^1.32.0",
    "pm2": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
